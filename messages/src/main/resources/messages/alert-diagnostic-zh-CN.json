{
  "TS0340001": {
    "message": "\u544a\u8b66\u5b57\u6bb5 `{field}` \u65e0\u6548\uff1a{reason}\u3002",
    "solution": "\u8bf7\u4f7f\u7528\u652f\u6301\u7684\u5b57\u6bb5\u7c7b\u578b\u3001\u53d6\u503c\u8303\u56f4\u548c\u53ef\u4fe1\u8eab\u4efd\u7ed1\u5b9a\u3002"
  },
  "TS0340002": {
    "message": "\u901a\u77e5\u6e20\u9053 `{channel}` \u5728 `{phase}` \u9636\u6bb5\u672a\u63a5\u53d7\u8bf7\u6c42\u3002",
    "solution": "\u91cd\u8bd5\u524d\u8bf7\u68c0\u67e5\u53d7\u9650\u7684\u534f\u8bae\u72b6\u6001\u548c\u539f\u59cb\u6295\u9012\u7ed1\u5b9a\u3002"
  },
  "TS0340003": {
    "message": "\u901a\u77e5\u6e20\u9053 `{channel}` \u5728 `{phase}` \u9636\u6bb5\u7684\u7ed3\u679c\u672a\u77e5\u3002",
    "solution": "\u63a5\u6536\u65b9\u53ef\u80fd\u5df2\u63a5\u53d7\u8bf7\u6c42\u3002\u8bf7\u4fdd\u7559\u6295\u9012\u8eab\u4efd\u5e76\u68c0\u67e5\u5df2\u6709\u7ed3\u679c\u3002"
  },
  "TS0340004": {
    "message": "\u901a\u77e5\u6e20\u9053 `{channel}` \u5728 `{phase}` \u9636\u6bb5\u4e0d\u53ef\u7528\u3002",
    "solution": "\u8bf7\u6062\u590d\u6240\u9700\u80fd\u529b\u6216\u53d7\u9650\u5bb9\u91cf\uff0c\u4fdd\u6301\u539f\u59cb\u6295\u9012\u8eab\u4efd\u4e0d\u53d8\u3002"
  },
  "TS0340005": {
    "message": "\u8be5\u901a\u77e5\u6d4b\u8bd5\u547d\u4ee4\u5df2\u88ab\u63a5\u53d7\uff0c\u4f46\u53c2\u6570\u4e0d\u540c\u3002",
    "solution": "\u8bf7\u67e5\u8be2\u539f\u547d\u4ee4\uff1b\u53ea\u6709\u660e\u786e\u6267\u884c\u53e6\u4e00\u9879\u6d4b\u8bd5\u65f6\u624d\u4f7f\u7528\u65b0\u547d\u4ee4\u3002"
  },
  "TS0340006": {
    "message": "\u8be5\u901a\u77e5\u6d4b\u8bd5\u547d\u4ee4\u7684\u9996\u6b21\u53d7\u7406\u65f6\u95f4\u7a97\u53e3\u5df2\u8fc7\u671f\u3002",
    "solution": "\u5982\u5b58\u5728\u539f\u59cb\u7ed3\u679c\uff0c\u8bf7\u5148\u67e5\u8be2\uff1b\u53ea\u6709\u660e\u786e\u6267\u884c\u53e6\u4e00\u9879\u6d4b\u8bd5\u65f6\u624d\u521b\u5efa\u65b0\u547d\u4ee4\u3002"
  },
  "TS0340007": {
    "message": "\u8be5\u901a\u77e5\u6d4b\u8bd5\u547d\u4ee4\u7684\u521b\u5efa\u65f6\u95f4\u8d85\u524d\u8fc7\u591a\u3002",
    "solution": "\u8bf7\u6821\u6b63\u5ba2\u6237\u7aef\u65f6\u949f\uff0c\u518d\u660e\u786e\u542f\u52a8\u65b0\u7684\u6d4b\u8bd5\u3002"
  },
  "TS0340008": {
    "message": "\u544a\u8b66\u64cd\u4f5c `{action}` \u4e0e\u5f53\u524d\u4e8b\u4ef6\u6216\u8bc4\u4f30\u4ee3\u6b21\u4e0d\u5339\u914d\u3002",
    "solution": "\u8bf7\u8bfb\u53d6\u5f53\u524d\u544a\u8b66\uff0c\u5e76\u9488\u5bf9\u5176\u51c6\u786e\u8eab\u4efd\u6267\u884c\u64cd\u4f5c\u3002"
  }
}
