{
  "TS0390001": {
    "message": "\u6e90 '{source}' \u4e2d\u6ca1\u6709\u540d\u4e3a '{collection}' \u7684\u96c6\u5408\u3002",
    "solution": "\u8bf7\u5217\u51fa\u8be5\u6e90\u7684\u5185\u5bb9\uff0c\u5e76\u9009\u62e9\u5176\u4e2d\u4e00\u4e2a\u540d\u79f0\u8bfb\u53d6\u3002"
  },
  "TS0390002": {
    "message": "\u4e0d\u652f\u6301\u4e00\u6b21\u8bfb\u53d6 {limit} \u884c\uff1b\u8bf7\u6307\u5b9a 1 \u5230 {max} \u4e4b\u95f4\u7684\u6570\u91cf\u3002",
    "solution": "\u8bf7\u6700\u591a\u8bfb\u53d6 {max} \u884c\uff0c\u6216\u4f7f\u7528\u7b5b\u9009\u6761\u4ef6\u7f29\u5c0f\u8303\u56f4\u3002"
  },
  "TS0390003": {
    "message": "\u5b57\u6bb5 '{field}' \u7684\u540d\u79f0\u542b\u70b9\uff0c\u65e0\u6cd5\u6309\u6b64\u5b57\u6bb5\u6392\u5e8f\u3002",
    "solution": "\u8bf7\u6309\u5176\u4ed6\u5b57\u6bb5\u6392\u5e8f\u3002\u4ecd\u53ef\u7b5b\u9009\u6b64\u5b57\u6bb5\uff0c\u4f46\u9700\u8981\u8f6c\u4e49\u540d\u79f0\u4e2d\u7684\u70b9\uff1ashell \u4e2d\u5199 price\\\\.usd\uff0cJSON \u4e2d\u5199 \"price\\\\\\\\.usd\"\uff0c\u56e0\u4e3a\u5355\u4e2a\u53cd\u659c\u6760\u4e0d\u662f\u5408\u6cd5\u7684 JSON \u8f6c\u4e49\u3002\u6b64\u7c7b\u7b5b\u9009\u4f1a\u8bfb\u53d6\u6bcf\u884c\uff1b\u7d22\u5f15\u540d\u79f0\u91c7\u7528\u8def\u5f84\u5f62\u5f0f\uff0c\u56e0\u6b64\u540d\u79f0\u542b\u70b9\u7684\u5b57\u6bb5\u65e0\u6cd5\u5efa\u7acb\u7d22\u5f15\u3002"
  },
  "TS0390004": {
    "message": "\u8fde\u63a5\u5668 '{connector}' \u4f7f\u7528\u81ea\u8eab\u683c\u5f0f\u8fd4\u56de\u8bfb\u53d6\u7ed3\u679c\uff0c\u800c\u6b64\u5165\u53e3\u6309\u6587\u6863\u8bfb\u53d6\uff0c\u56e0\u6b64\u65e0\u6cd5\u6d4f\u89c8\u5176\u884c\u3002",
    "solution": "\u8bf7\u6d4f\u89c8\u4ee5\u4e0b\u8fde\u63a5\u5668\u7684\u6e90\uff1a{browsable}\u3002\u5f53\u524d\u6e90\u4ecd\u53ef\u5217\u51fa\u5185\u5bb9\u3001\u7edf\u8ba1\u5927\u5c0f\uff0c\u5e76\u7531 Pipeline \u8bfb\u53d6\u3002"
  },
  "TS0390005": {
    "message": "\u8ddf\u968f\u5df2\u505c\u6b62\uff1a\u88ab\u8ddf\u968f\u7684\u6e90\u5df2\u5220\u9664\u3002",
    "solution": "\u8bf7\u91cd\u65b0\u58f0\u660e\u8be5\u6e90\uff0c\u6216\u8ddf\u968f\u4ecd\u7136\u5b58\u5728\u7684\u6e90\u4e2d\u7684\u96c6\u5408\u3002"
  },
  "TS0390006": {
    "message": "\u8ddf\u968f\u5df2\u505c\u6b62\uff1a\u6e90\u7684\u6d41\u53d1\u751f\u6545\u969c\u3002",
    "solution": "\u8bf7\u67e5\u770b\u670d\u52a1\u5668\u65e5\u5fd7\u4e2d\u7684\u8fde\u63a5\u5668\u62a5\u544a\uff0c\u518d\u91cd\u65b0\u8ddf\u968f\u3002"
  },
  "TS0390007": {
    "message": "\u8fde\u7eed 10 \u5206\u949f\u6ca1\u6709\u53d8\u66f4\uff0c\u8ddf\u968f\u5df2\u505c\u6b62\uff0c\u5e76\u5df2\u5f52\u8fd8\u5360\u7528\u7684\u8fde\u63a5\u5668\u5b9e\u4f8b\u3002",
    "solution": "\u5982\u9700\u7ee7\u7eed\u89c2\u5bdf\uff0c\u8bf7\u91cd\u65b0\u5f00\u59cb\u8ddf\u968f\u3002"
