{
  "TS0270001": {
    "message": "Pipeline {pipeline} \u5c06\u8868 {table} \u7684\u5217 {column} \u5199\u5165 {target}\uff1b\u8be5\u76ee\u6807\u5c06\u952e\u4e2d\u7684\u70b9\u89e3\u91ca\u4e3a\u5d4c\u5957\u6587\u6863\u8def\u5f84\uff0c\u800c\u4e0d\u662f\u540d\u79f0\u7684\u4e00\u90e8\u5206\u3002",
    "solution": "\u884c\u5df2\u6b63\u786e\u4f20\u8f93\uff0c\u952e\u4e5f\u5df2\u5199\u5165\uff0c\u4f46\u5728 {target} \u4e2d\u8bfb\u53d6 {column} \u65f6\u5fc5\u987b\u8f6c\u4e49\u70b9\uff1b\u7531\u4e8e\u7d22\u5f15\u952e\u4f7f\u7528\u76f8\u540c\u7684\u8def\u5f84\u8bed\u6cd5\uff0c\u65e0\u6cd5\u4e3a\u8be5\u952e\u521b\u5efa\u7d22\u5f15\u3002\u5982\u679c\u9700\u8981\u67e5\u8be2\u6216\u7d22\u5f15\u6b64\u5217\uff0c\u8bf7\u5728 {source} \u4e2d\u91cd\u547d\u540d\uff0c\u6216\u5728\u5199\u5165\u524d\u901a\u8fc7 map \u6b65\u9aa4\u5c06\u5176\u6539\u4e3a\u4e0d\u542b\u70b9\u7684\u540d\u79f0\u3002"
  },
  "TS0270002": {
    "message": "\u6e90 {source} \u7684\u8868 {table} \u4e2d\u6709\u540d\u4e3a {column} \u7684\u5217\uff0c\u8be5\u540d\u79f0\u7531 Tapstate \u4fdd\u7559\uff1b\u4ece\u6b64\u5904\u8d77\u8be5\u5217\u4ee5 {renamed} \u8bfb\u53d6\u3002",
    "solution": "\u6570\u636e\u4e0d\u4f1a\u4e22\u5931\uff1a\u6240\u6709\u503c\u7167\u5e38\u4f20\u9012\uff0c\u4e3b\u952e\u5217\u7684\u503c\u4fdd\u7559\u5728\u65b0\u540d\u79f0\u4e0b\u3002\u5728\u7ba1\u9053\u4e2d\u5f15\u7528\u8be5\u5217\u65f6\u8bf7\u4f7f\u7528 {renamed}\uff0c\u76ee\u6807\u4e2d\u7684\u5b57\u6bb5\u540d\u4e5f\u5c06\u662f {renamed}\u3002"
  },
  "TS0270003": {
    "message": "\u6e90 {source} \u7684\u8868 {table} \u4e2d\u65e2\u6709\u4f7f\u7528 Tapstate \u4fdd\u7559\u540d\u79f0\u7684\u5217\uff0c\u53c8\u6709\u540d\u4e3a {renamed} \u7684\u5217\uff0c\u800c\u524d\u8005\u672c\u5e94\u4ee5\u8be5\u540d\u79f0\u8bfb\u53d6\u3002",
    "solution": "\u8bf7\u5728\u6e90\u4e2d\u91cd\u547d\u540d\u5176\u4e2d\u4e00\u5217\uff0c\u6216\u5c06\u8be5\u8868\u4ece\u6b64\u6e90\u7684\u8868\u4e2d\u6392\u9664\u3002\u4e24\u5217\u4e0d\u80fd\u4ee5\u540c\u4e00\u540d\u79f0\u8bfb\u53d6\u3002"
  }
}
