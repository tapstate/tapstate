{
  "TS0340001": {
    "message": "\u544a\u8b66\u6b04\u4f4d `{field}` \u7121\u6548\uff1a{reason}\u3002",
    "solution": "\u8acb\u4f7f\u7528\u652f\u63f4\u7684\u6b04\u4f4d\u985e\u578b\u3001\u53d6\u503c\u7bc4\u570d\u548c\u53ef\u4fe1\u8eab\u5206\u7d81\u5b9a\u3002"
  },
  "TS0340002": {
    "message": "\u901a\u77e5\u7ba1\u9053 `{channel}` \u5728 `{phase}` \u968e\u6bb5\u672a\u63a5\u53d7\u8acb\u6c42\u3002",
    "solution": "\u91cd\u8a66\u524d\u8acb\u6aa2\u67e5\u53d7\u9650\u7684\u5354\u5b9a\u72c0\u614b\u548c\u539f\u59cb\u6295\u905e\u7d81\u5b9a\u3002"
  },
  "TS0340003": {
    "message": "\u901a\u77e5\u7ba1\u9053 `{channel}` \u5728 `{phase}` \u968e\u6bb5\u7684\u7d50\u679c\u672a\u77e5\u3002",
    "solution": "\u63a5\u6536\u65b9\u53ef\u80fd\u5df2\u63a5\u53d7\u8acb\u6c42\u3002\u8acb\u4fdd\u7559\u6295\u905e\u8eab\u5206\u4e26\u6aa2\u67e5\u65e2\u6709\u7d50\u679c\u3002"
  },
  "TS0340004": {
    "message": "\u901a\u77e5\u7ba1\u9053 `{channel}` \u5728 `{phase}` \u968e\u6bb5\u7121\u6cd5\u4f7f\u7528\u3002",
    "solution": "\u8acb\u6062\u5fa9\u6240\u9700\u80fd\u529b\u6216\u53d7\u9650\u5bb9\u91cf\uff0c\u4fdd\u6301\u539f\u59cb\u6295\u905e\u8eab\u5206\u4e0d\u8b8a\u3002"
  },
  "TS0340005": {
    "message": "\u8a72\u901a\u77e5\u6e2c\u8a66\u547d\u4ee4\u5df2\u88ab\u63a5\u53d7\uff0c\u4f46\u53c3\u6578\u4e0d\u540c\u3002",
    "solution": "\u8acb\u67e5\u8a62\u539f\u547d\u4ee4\uff1b\u53ea\u6709\u660e\u78ba\u57f7\u884c\u53e6\u4e00\u9805\u6e2c\u8a66\u6642\u624d\u4f7f\u7528\u65b0\u547d\u4ee4\u3002"
  },
  "TS0340006": {
    "message": "\u8a72\u901a\u77e5\u6e2c\u8a66\u547d\u4ee4\u7684\u9996\u6b21\u53d7\u7406\u6642\u9593\u8996\u7a97\u5df2\u904e\u671f\u3002",
    "solution": "\u5982\u6709\u539f\u59cb\u7d50\u679c\uff0c\u8acb\u5148\u67e5\u8a62\uff1b\u53ea\u6709\u660e\u78ba\u57f7\u884c\u53e6\u4e00\u9805\u6e2c\u8a66\u6642\u624d\u5efa\u7acb\u65b0\u547d\u4ee4\u3002"
  },
  "TS0340007": {
    "message": "\u8a72\u901a\u77e5\u6e2c\u8a66\u547d\u4ee4\u7684\u5efa\u7acb\u6642\u9593\u8d85\u524d\u904e\u591a\u3002",
    "solution": "\u8acb\u6821\u6b63\u7528\u6236\u7aef\u6642\u9418\uff0c\u518d\u660e\u78ba\u555f\u52d5\u65b0\u7684\u6e2c\u8a66\u3002"
  },
  "TS0340008": {
    "message": "\u544a\u8b66\u64cd\u4f5c `{action}` \u8207\u76ee\u524d\u4e8b\u4ef6\u6216\u8a55\u4f30\u4e16\u4ee3\u4e0d\u7b26\u3002",
    "solution": "\u8acb\u8b80\u53d6\u76ee\u524d\u544a\u8b66\uff0c\u4e26\u91dd\u5c0d\u5176\u78ba\u5207\u8eab\u5206\u57f7\u884c\u64cd\u4f5c\u3002"
  }
}
