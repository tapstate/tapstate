{
  "TS0390001": {
    "message": "\u4f86\u6e90 '{source}' \u4e2d\u6c92\u6709\u540d\u70ba '{collection}' \u7684\u96c6\u5408\u3002",
    "solution": "\u8acb\u5217\u51fa\u8a72\u4f86\u6e90\u7684\u5167\u5bb9\uff0c\u4e26\u9078\u64c7\u5176\u4e2d\u4e00\u500b\u540d\u7a31\u8b80\u53d6\u3002"
  },
  "TS0390002": {
    "message": "\u4e0d\u652f\u63f4\u4e00\u6b21\u8b80\u53d6 {limit} \u5217\uff1b\u8acb\u6307\u5b9a 1 \u5230 {max} \u4e4b\u9593\u7684\u6578\u91cf\u3002",
    "solution": "\u8acb\u6700\u591a\u8b80\u53d6 {max} \u5217\uff0c\u6216\u4f7f\u7528\u7be9\u9078\u689d\u4ef6\u7e2e\u5c0f\u7bc4\u570d\u3002"
  },
  "TS0390003": {
    "message": "\u6b04\u4f4d '{field}' \u7684\u540d\u7a31\u542b\u9ede\uff0c\u7121\u6cd5\u4f9d\u6b64\u6b04\u4f4d\u6392\u5e8f\u3002",
    "solution": "\u8acb\u4f9d\u5176\u4ed6\u6b04\u4f4d\u6392\u5e8f\u3002\u4ecd\u53ef\u7be9\u9078\u6b64\u6b04\u4f4d\uff0c\u4f46\u9700\u8981\u8df3\u812b\u540d\u7a31\u4e2d\u7684\u9ede\uff1ashell \u4e2d\u5beb price\\\\.usd\uff0cJSON \u4e2d\u5beb \"price\\\\\\\\.usd\"\uff0c\u56e0\u70ba\u55ae\u4e00\u53cd\u659c\u7dda\u4e0d\u662f\u5408\u6cd5\u7684 JSON \u8df3\u812b\u3002\u6b64\u985e\u7be9\u9078\u6703\u8b80\u53d6\u6bcf\u5217\uff1b\u7d22\u5f15\u540d\u7a31\u63a1\u7528\u8def\u5f91\u5f62\u5f0f\uff0c\u56e0\u6b64\u540d\u7a31\u542b\u9ede\u7684\u6b04\u4f4d\u7121\u6cd5\u5efa\u7acb\u7d22\u5f15\u3002"
  },
  "TS0390004": {
    "message": "\u9023\u63a5\u5668 '{connector}' \u4f7f\u7528\u81ea\u8eab\u683c\u5f0f\u50b3\u56de\u8b80\u53d6\u7d50\u679c\uff0c\u800c\u6b64\u5165\u53e3\u4f9d\u6587\u4ef6\u8b80\u53d6\uff0c\u56e0\u6b64\u7121\u6cd5\u700f\u89bd\u5176\u5217\u3002",
    "solution": "\u8acb\u700f\u89bd\u4ee5\u4e0b\u9023\u63a5\u5668\u7684\u4f86\u6e90\uff1a{browsable}\u3002\u76ee\u524d\u4f86\u6e90\u4ecd\u53ef\u5217\u51fa\u5167\u5bb9\u3001\u7d71\u8a08\u5927\u5c0f\uff0c\u4e26\u7531 Pipeline \u8b80\u53d6\u3002"
  },
  "TS0390005": {
    "message": "\u8ffd\u8e64\u5df2\u505c\u6b62\uff1a\u88ab\u8ffd\u8e64\u7684\u4f86\u6e90\u5df2\u522a\u9664\u3002",
    "solution": "\u8acb\u91cd\u65b0\u5ba3\u544a\u8a72\u4f86\u6e90\uff0c\u6216\u8ffd\u8e64\u4ecd\u7136\u5b58\u5728\u7684\u4f86\u6e90\u4e2d\u7684\u96c6\u5408\u3002"
  },
  "TS0390006": {
    "message": "\u8ffd\u8e64\u5df2\u505c\u6b62\uff1a\u4f86\u6e90\u4e32\u6d41\u767c\u751f\u6545\u969c\u3002",
    "solution": "\u8acb\u67e5\u770b\u4f3a\u670d\u5668\u65e5\u8a8c\u4e2d\u7684\u9023\u63a5\u5668\u5831\u544a\uff0c\u518d\u91cd\u65b0\u8ffd\u8e64\u3002"
  },
  "TS0390007": {
    "message": "\u9023\u7e8c 10 \u5206\u9418\u6c92\u6709\u8b8a\u66f4\uff0c\u8ffd\u8e64\u5df2\u505c\u6b62\uff0c\u4e26\u5df2\u6b78\u9084\u5360\u7528\u7684\u9023\u63a5\u5668\u57f7\u884c\u500b\u9ad4\u3002",
    "solution": "\u5982\u9700\u7e7c\u7e8c\u89c0\u5bdf\uff0c\u8acb\u91cd\u65b0\u958b\u59cb\u8ffd\u8e64\u3002"
  }
}
