{
  "TS0270001": {
    "message": "Pipeline {pipeline} \u5c07\u8cc7\u6599\u8868 {table} \u7684\u6b04\u4f4d {column} \u5beb\u5165 {target}\uff1b\u8a72\u76ee\u6a19\u5c07\u9375\u4e2d\u7684\u9ede\u89e3\u8b80\u70ba\u5de2\u72c0\u6587\u4ef6\u8def\u5f91\uff0c\u800c\u4e0d\u662f\u540d\u7a31\u7684\u4e00\u90e8\u5206\u3002",
    "solution": "\u8cc7\u6599\u5217\u5df2\u6b63\u78ba\u50b3\u8f38\uff0c\u9375\u4e5f\u5df2\u5beb\u5165\uff0c\u4f46\u5728 {target} \u4e2d\u8b80\u53d6 {column} \u6642\u5fc5\u9808\u8df3\u812b\u9ede\uff1b\u7531\u65bc\u7d22\u5f15\u9375\u4f7f\u7528\u76f8\u540c\u7684\u8def\u5f91\u8a9e\u6cd5\uff0c\u7121\u6cd5\u70ba\u8a72\u9375\u5efa\u7acb\u7d22\u5f15\u3002\u5982\u679c\u9700\u8981\u67e5\u8a62\u6216\u7d22\u5f15\u6b64\u6b04\u4f4d\uff0c\u8acb\u5728 {source} \u4e2d\u91cd\u65b0\u547d\u540d\uff0c\u6216\u5728\u5beb\u5165\u524d\u900f\u904e map \u6b65\u9a5f\u5c07\u5176\u6539\u70ba\u4e0d\u542b\u9ede\u7684\u540d\u7a31\u3002"
  },
  "TS0270002": {
    "message": "\u4f86\u6e90 {source} \u7684\u8cc7\u6599\u8868 {table} \u4e2d\u6709\u540d\u70ba {column} \u7684\u6b04\u4f4d\uff0c\u8a72\u540d\u7a31\u7531 Tapstate \u4fdd\u7559\uff1b\u5f9e\u6b64\u8655\u8d77\u8a72\u6b04\u4f4d\u4ee5 {renamed} \u8b80\u53d6\u3002",
    "solution": "\u8cc7\u6599\u4e0d\u6703\u907a\u5931\uff1a\u6240\u6709\u503c\u7167\u5e38\u50b3\u905e\uff0c\u4e3b\u9375\u6b04\u4f4d\u7684\u503c\u4fdd\u7559\u5728\u65b0\u540d\u7a31\u4e0b\u3002\u5728\u7ba1\u9053\u4e2d\u5f15\u7528\u8a72\u6b04\u4f4d\u6642\u8acb\u4f7f\u7528 {renamed}\uff0c\u76ee\u6a19\u4e2d\u7684\u6b04\u4f4d\u540d\u7a31\u4e5f\u5c07\u662f {renamed}\u3002"
  },
  "TS0270003": {
    "message": "\u4f86\u6e90 {source} \u7684\u8cc7\u6599\u8868 {table} \u4e2d\u65e2\u6709\u4f7f\u7528 Tapstate \u4fdd\u7559\u540d\u7a31\u7684\u6b04\u4f4d\uff0c\u53c8\u6709\u540d\u70ba {renamed} \u7684\u6b04\u4f4d\uff0c\u800c\u524d\u8005\u672c\u61c9\u4ee5\u8a72\u540d\u7a31\u8b80\u53d6\u3002",
    "solution": "\u8acb\u5728\u4f86\u6e90\u4e2d\u91cd\u65b0\u547d\u540d\u5176\u4e2d\u4e00\u500b\u6b04\u4f4d\uff0c\u6216\u5c07\u8a72\u8cc7\u6599\u8868\u5f9e\u6b64\u4f86\u6e90\u7684\u8cc7\u6599\u8868\u4e2d\u6392\u9664\u3002\u5169\u500b\u6b04\u4f4d\u4e0d\u80fd\u4ee5\u540c\u4e00\u540d\u7a31\u8b80\u53d6\u3002"
  }
}
