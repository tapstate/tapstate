<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tapstate</groupId>
    <artifactId>runtime</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>srs</artifactId>
  <name>Tapstate :: Runtime :: SRS</name>
  <description>Source Replica Store write surface: the per-table change ring and the mining-chain meta model</description>

  <dependencies>
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-event</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The error-code kernel: user-facing capture faults (an unparsable start_from) are thrown as coded
         TapstateExceptions, not bare strings. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-common</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The pipeline read mode: the consumption plan branches the capture topology off it. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-model</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The stage vocabulary: the source processor declares which stage of the graph its time is
         measured under, and the closed set of stages lives with the metric fact model. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-lifecycle</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>spi-capture</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The durable coordination store's value model: the consumer cursors the durable-frontier bound
         reads (each consumer's sink-acked source position), and the meta store the source read offset is
         persisted through. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>spi-store</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The change ring's substrate: a per-table Hazelcast Ringbuffer holds the in-memory cdc buffer
         (rule R4 allows the runtime ring to depend on Hazelcast). -->
    <dependency>
      <groupId>com.hazelcast</groupId>
      <artifactId>hazelcast</artifactId>
    </dependency>

    <!-- The execution engine (DAG builder + generic sink adapter): a test-scope dependency for the
         source-to-DAG composition test only. The engine never depends on this source ring in either
         direction at compile scope; this edge exists solely so a test can wire the projected source
         into a builder-assembled DAG and run it. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>engine</artifactId>
      <version>${revision}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
