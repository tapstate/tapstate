<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tapstate</groupId>
    <artifactId>runtime</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>engine</artifactId>
  <name>Tapstate :: Runtime :: Engine</name>
  <description>Data-plane execution (the pipeline runtime): the Jet job lifecycle actuator (submit /
    suspend / resume / cancel) that maps a pipeline's lifecycle to its Jet job, the generic adapters that
    wrap a stateless transform port and a sink writer into Jet processors, and the construction of a
    pipeline's Jet DAG. Depends on core + spi and the Hazelcast execution substrate only (rule R4);
    never on an adapter.</description>

  <dependencies>
    <!-- The resource model the DAG builder reads to compile a pipeline into a Jet job; core ring,
         zero third-party (rule R4: core + spi only). -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-model</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- The carrier-agnostic plan a join declaration compiles to, and the evaluation of the
         expressions its output columns are written from. Core ring, so rule R4 admits it.

         No exclusions, and that is deliberate. Excluding the SQL library here reads like tightening
         the ring - nothing in this module names one of its types - but a Maven exclusion applies to
         everything downstream of this path, and this is the path the assembly root reaches core-sql
         by. Measured: with the exclusions, zero of that library's artifacts were on the assembly
         root's classpath; without them, three. The offline gate that refuses join SQL this release
         cannot run is parsed there, so the exclusion turned it into a link error on the first
         pipeline carrying a join - and the whole build stayed green, because nothing runs that gate
         on the assembled classpath. What actually keeps this module from naming those types is the
         package-level R4 rule, which is checked rather than assumed. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-sql</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- The stateless transform seam the runtime adapter wraps; brings the event envelope currency
         transitively (rule R4: core + spi only). -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>spi-transform</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- The write-side sink seam the runtime adapter drives: the generic sink processor batches
         events into a SinkWriter and paces its in-flight writes. A pure spi contract; the connector
         type never reaches the engine (rule R4: core + spi only). -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>spi-sink</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- The cold layer under a stateful operator's state maps: an entry per key within a namespace,
         with no way to enumerate one. A pure spi contract; which database stands behind it is the
         assembly root's choice and no driver type reaches the engine (rule R4: core + spi only). -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>spi-store</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- The execution substrate: the member and the Jet engine ship in this one artifact (rule R4:
         Hazelcast is the one allowed substrate for the runtime ring); the actuator submits / suspends /
         resumes / cancels Jet jobs on it. Version managed by the bom. -->
    <dependency>
      <groupId>com.hazelcast</groupId>
      <artifactId>hazelcast</artifactId>
    </dependency>
    <!-- The error-code contract for diagnosable job-operation failures (rule R4: core only). -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-common</artifactId>
      <version>${revision}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
