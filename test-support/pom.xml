<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test scaffolding shared by more than one module. Nothing here ships: these are test sources, and what
  the module publishes is a test-jar that consumers take in test scope. It is the one place allowed to
  hold a decision that several test suites must make the same way.
  It exists because the alternative did not work. The Docker gate started inside e2e, but the suites
  that most needed it - the store adapter's and the assembly root's - sit *below* e2e in the reactor,
  so reaching it would have been a backwards dependency. Copying the decision into each module would
  have let the copies drift, which for a gate means one of them quietly stops gating.
  Test sources rather than main ones, deliberately. Scaffolding held as main code is product code as far
  as every tool is concerned: the coverage gate would measure it, and the end-to-end admission gate would
  demand a specification for changes to it. Both would have needed an exemption written down somewhere,
  and this needs none - it is test code, and every tool already knows what to do with test code.
  The ring rules R1-R10 do not reach it either: they are written per ring package, and io.tapstate.testsupport
  is in none of them - the same standing e2e and arch-tests have.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tapstate</groupId>
    <artifactId>tapstate</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>test-support</artifactId>
  <name>Tapstate :: Test Support</name>
  <description>Test scaffolding shared across modules; published as a test-jar, never shipped</description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.tapstate</groupId>
        <artifactId>bom</artifactId>
        <version>${revision}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.mongodb</groupId>
      <artifactId>bson</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The test-jar is the artifact here; the main jar this module also produces is empty. A
           test-jar's own dependencies do not reach its consumers, which is fine because every consumer
           drives containers itself and already declares JUnit and Testcontainers. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
