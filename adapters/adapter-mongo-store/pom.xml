<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tapstate</groupId>
    <artifactId>adapters</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>adapter-mongo-store</artifactId>
  <name>Tapstate :: Adapters :: Mongo Store</name>
  <!-- The only module allowed to depend on the Mongo driver (rule R3). At L1 it carries the
       connection substrate (reach + replica-set check), the three storage-port sub-stores (artifact
       truth layer, epoch-fencing CAS state, connection catalog), and the single point that
       translates driver failures into coded diagnostics, so no driver type escapes the module. -->
  <description>MongoDB storage adapter: the connection substrate (reach + replica-set check + coded diagnostics), the artifact truth-layer store (canonical save / get / list), the CAS state store (epoch-fencing compare-and-swap on the pipeline checkpoint), and the connection catalog store (structured connection configs), with driver failures translated into io-domain coded diagnostics</description>

  <dependencies>
    <!-- Shared test scaffolding: the Docker gate these suites are held to. A test-jar in test
         scope - nothing from it reaches the shipped artifact. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>test-support</artifactId>
      <version>${revision}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <!-- The error-code contract: this module raises coded diagnostics (store.* domain) when the
         store is unreachable or is not a replica set, translated from driver exceptions here so no
         driver type escapes the module (rule R3). -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-common</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The storage port this adapter implements: the artifact truth layer (save / get / list). -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>spi-store</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The resource model and its canonical serializer: an artifact is stored in canonical form. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-model</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The canonical parser (the inverse of the canonical writer): reconstructs a stored resource
         from its canonical form on read, so the store keeps a single serialization contract. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-dsl</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The connector catalog row model and its serde (writer / reader): the derived-row store persists
         a normalized ConnectorCatalogEntry, reusing the catalog product's serde so the persisted shape
         matches the bundled one. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-catalog</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The Mongo sync driver. Rule R3: this is the only module permitted to depend on it. -->
    <dependency>
      <groupId>org.mongodb</groupId>
      <artifactId>mongodb-driver-sync</artifactId>
    </dependency>

    <!-- The logging facade, for the one thing in this module that has to narrate itself: a system-data
         migration runs before the server is up and can take a while, so an operator watching a start
         that has not finished needs to be told which step is running and how long the last one took.
         API only; whichever backend the process already has picks it up. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The checkpoint + fencing-CAS contract (pure) the state store persists and returns
         (CheckpointDoc / CasOutcome). The Testcontainers witness also runs the pure contract beside a
         real Mongo replica-set so the two cannot drift from real findOneAndUpdate behavior. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-lifecycle</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- Testcontainers: a throwaway Mongo replica-set (and a standalone, to witness the
         not-a-replica-set diagnostic). Skipped automatically where Docker is absent. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mongodb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Testcontainers-backed witness tests (*IT) run in the integration-test phase, so `mvn test`
           stays fast and `mvn verify` exercises them. Each is annotated to skip automatically where
           Docker is unavailable, so a Docker-less build stays green. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
