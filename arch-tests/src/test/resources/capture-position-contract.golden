io.tapstate.spi.capture.CaptureListener :: method :: onBatch(java.util.List<io.tapstate.core.event.Envelope>, java.util.Optional<io.tapstate.spi.capture.SourcePosition>) -> void
io.tapstate.spi.capture.CaptureListener :: method :: onError(java.lang.Throwable) -> void
io.tapstate.spi.capture.CapturePort :: method :: cdc(io.tapstate.spi.capture.CaptureConfig, io.tapstate.spi.capture.CaptureStart, io.tapstate.spi.capture.CaptureListener) -> io.tapstate.spi.capture.Subscription
io.tapstate.spi.capture.CapturePort :: method :: discoverSchema(io.tapstate.spi.capture.CaptureConfig) -> io.tapstate.spi.capture.DiscoveredSchema
io.tapstate.spi.capture.CapturePort :: method :: snapshot(io.tapstate.spi.capture.CaptureConfig) -> io.tapstate.spi.capture.CaptureBatch
io.tapstate.spi.capture.CapturePort :: method :: testConnection(io.tapstate.spi.capture.CaptureConfig) -> io.tapstate.spi.capture.ConnectionReport
io.tapstate.spi.capture.CaptureStart :: method :: present() -> io.tapstate.spi.capture.CaptureStart
io.tapstate.spi.capture.CaptureStart :: method :: resume(io.tapstate.spi.capture.SourcePosition) -> io.tapstate.spi.capture.CaptureStart
io.tapstate.spi.capture.CaptureStart :: permits :: io.tapstate.spi.capture.CaptureStart$Present
io.tapstate.spi.capture.CaptureStart :: permits :: io.tapstate.spi.capture.CaptureStart$Resume
io.tapstate.spi.capture.CaptureStart$Resume :: component :: position :: io.tapstate.spi.capture.SourcePosition
io.tapstate.spi.capture.SourcePosition :: component :: token :: java.lang.String
