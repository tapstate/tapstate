{
  "schemaVersion": 1,
  "recoveryProfiles": {
    "legacy-preserve": {
      "goal": "Retain old-layout facts without treating them as a new three-layer installation.",
      "entry": "Matching old-version backup/diagnostics; no automatic cross-layout migration.",
      "prerequisites": [
        "Original legacy identity and matching version/backup are retained.",
        "The current three-layer root does not admit this legacy layout."
      ]
    },
    "session-record-recovery-v1": {
      "goal": "Retain existing standalone and Cloud session records and Cloud revocation markers across process restarts; a missing optional email remains readable.",
      "entry": "Read the original session from the existing store after restart or restore a matching legacy backup; a missing or expired session requires a new login.",
      "prerequisites": [
        "The original sessions collection and matching deployment identity remain available or are restored from a matching legacy backup.",
        "Authentication requires the matching browser credential, the persisted secret hash, an unrevoked record and a valid idle deadline.",
        "A backup cannot establish revocations made after it was taken; the feature does not reconstruct those later revocations."
      ]
    },
    "existing-operator-state-missing-objects-v1": {
      "goal": "Recover existing keyed operator state and retain responsibility for object references absent from the last emitted root document.",
      "entry": "Resume the existing operator namespace and root key using its stored RootAssembly, matching lookup rows, reverse references and source positions; re-evaluate old serialized bytes that have no missing-reference field.",
      "prerequisites": [
        "The same configured operator-state database, namespace and root identity remain available.",
        "Each sparse missing-reference entry names its stable slot path, lookup namespace and composite key.",
        "Snapshot completion is scoped to the source generation and all producers and lookup partitions; an old generation cannot settle a new load.",
        "Old serialized bytes mean pending re-determination, not an already-complete root; no state reset or forced reload substitutes for compatible recovery."
      ]
    }
  },
  "consistencyProfiles": {
    "legacy": {
      "atomicDomain": "LEGACY",
      "fencing": "Matching legacy migration/ownership behavior; not admitted by the three-layer root."
    },
    "session-record-write-v1": {
      "atomicDomain": "STORE: one sessions collection document per session or revocation marker.",
      "fencing": "Managed sessions use a unique deployment and JWT identity and insert-only creation; authentication and logout use conditional single-document updates, while signed callbacks retain deny markers. Standalone session keys use a distinct key type."
    },
    "existing-single-root-write": {
      "atomicDomain": "Existing keyed operator-state write for one namespace and root key; no additional collection or cross-key transaction.",
      "fencing": "Keep existing owner and source-order rules. Record missing identities with the missing-object emission and clear or recompute them on completion, retargeting, root deletion and subsequent root output. Source progress cannot substitute for target confirmation."
    }
  },
