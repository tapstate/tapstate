{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tapstate.io/schema/e2e/spec-v1.json",
  "title": "Tapstate e2e test specification",
  "description": "A declarative end-to-end specification. The same document runs on every tier; generated from the executor, so it says what the parser accepts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "pipeline",
    "steps"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "What this specification is called."
    },
    "setup": {
      "$ref": "#/$defs/setup",
      "description": "The bootstrap a real endpoint needs before a pipeline can name it."
    },
    "pipeline": {
      "type": "string",
      "description": "Path to the product pipeline document, read with the product's own parser."
    },
    "seed": {
      "$ref": "#/$defs/seed",
      "description": "Initial data laid down before the first step runs."
    },
    "steps": {
      "type": "array",
      "description": "The scenario, in order. A specification with no steps checks nothing.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "setup": {
      "type": "object",
      "description": "What the harness brings up, then the three product verbs run against it, in dependency order.",
      "additionalProperties": false,
      "properties": {
        "databases": {
          "type": "object",
          "description": "Stores the harness provisions first, keyed by the name whose address the resources interpolate.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "description": "What sort of store, which settles provisioning, address shape and driver.",
                "enum": [
                  "mongo",
                  "mysql"
                ]
              }
            }
          }
        },
        "connectors": {
          "type": "array",
          "description": "Connector ids whose runtime jars are registered; idempotent by content hash.",
          "items": {
            "type": "string"
          }
        },
        "apply": {
          "type": "array",
          "description": "Product resource files, applied as one batch: the product resolves references within the submitted set.",
          "items": {
            "type": "string"
          }
        },
        "discover": {
          "type": "array",
          "description": "Resource ids whose source model is discovered, feeding target-table creation.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "seed": {
      "type": "object",
      "description": "Rows per table, addressed as <resourceId>.<table>.",
      "propertyNames": {
        "pattern": "^[^.]+\\..+$"
      },
      "additionalProperties": {
        "description": "A generated count, or the rows themselves - one of the two.",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rows"
            ],
            "properties": {
              "rows": {
                "type": "integer",
                "description": "How many generated rows to lay down: ids 1..N, each with seq equal to its id.",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "values"
            ],
            "properties": {
              "values": {
                "type": "array",
                "description": "The rows themselves, when what they hold is the point.",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "description": "One row: columns and values. Every row of a table carries the same columns.",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "The key rows are seeded and upserted by."
                    }
                  },
                  "additionalProperties": {
                    "type": [
                      "integer",
                      "string"
                    ],
                    "description": "An integer or a string; wider value types are a widening of the vocabulary."
                  }
                }
              }
            }
          }
        ]
      }
    },
    "step": {
      "description": "One stage. Steps run in declaration order; the order is the scenario.",
      "oneOf": [
        {
          "type": "string",
          "description": "A lifecycle verb, spelled as the product spells it. There is no rewind: re-snapshotting is stop then start.",
          "enum": [
            "pause",
            "resume",
            "start",
            "stop"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cdc"
          ],
          "properties": {
            "cdc": {
              "type": "object",
              "description": "Exactly one table, addressed as <resourceId>.<table>.",
              "minProperties": 1,
              "maxProperties": 1,
              "propertyNames": {
                "pattern": "^[^.]+\\..+$"
              },
              "additionalProperties": {
                "type": "string",
                "description": "A change, written '<operation> <rows>'.",
                "pattern": "^(delete|insert|update)\\s+\\d+$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "await"
          ],
          "properties": {
            "await": {
              "$ref": "#/$defs/matcher"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assert"
          ],
          "properties": {
            "assert": {
              "$ref": "#/$defs/matcher"
            }
          }
        }
      ]
    },
    "matcher": {
      "description": "A condition over observable state. One vocabulary serves both timings: assert reads once, await polls the same matcher until it holds or the bound expires.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count"
          ],
          "properties": {
            "count": {
              "type": "object",
              "description": "Expected rows per table, read from the endpoint itself.",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[^.]+\\..+$"
              },
              "additionalProperties": {
                "type": "integer",
                "description": "Rows the table is expected to hold.",
                "minimum": 0
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "doc"
          ],
          "properties": {
            "doc": {
              "type": "object",
              "description": "Exactly one table, addressed as <resourceId>.<table>.",
              "minProperties": 1,
              "maxProperties": 1,
              "propertyNames": {
                "pattern": "^[^.]+\\..+$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "where"
                ],
                "description": "One document, located and read at the endpoint itself. Carry expect or size - a doc that expects nothing checks nothing.",
                "properties": {
                  "where": {
                    "type": "object",
                    "description": "Equality settings locating exactly one document. Identity is spelled id whatever the store calls it.",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": [
                        "integer",
                        "string"
                      ],
                      "description": "An integer or a string; wider value types are a widening of the vocabulary."
                    }
                  },
                  "expect": {
                    "type": "object",
                    "description": "Scalar values by path: a.b for a field of a field, items[0].sku for a field of a list element.",
                    "additionalProperties": {
                      "type": [
                        "integer",
                        "string"
                      ],
                      "description": "An integer or a string; wider value types are a widening of the vocabulary."
                    }
                  },
                  "size": {
                    "type": "object",
                    "description": "List lengths by path.",
                    "additionalProperties": {
                      "type": "integer",
                      "description": "How many elements the list at this path holds.",
                      "minimum": 0
                    }
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "expect"
                    ]
                  },
                  {
                    "required": [
                      "size"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error_count"
          ],
          "properties": {
            "error_count": {
              "type": "integer",
              "description": "The published error count the pipeline is expected to show.",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "description": "The lifecycle state of the pipeline this specification names. A specification names exactly one, so the state is written on its own.",
              "enum": [
                "COMPLETED",
                "FAILED",
                "NEW",
                "PAUSED",
                "RUNNING",
                "STOPPED"
              ]
            }
          }
        }
      ]
    }
  }
}
