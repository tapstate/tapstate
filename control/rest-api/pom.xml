<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tapstate</groupId>
    <artifactId>control</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>rest-api</artifactId>
  <name>Tapstate :: Control :: REST API</name>
  <description>HTTP presentation adapter over control-core: the Spring Boot Web MVC face that projects
    the control verbs onto a single-context, single-port HTTP surface under the /api prefix.</description>

  <dependencies>
    <!-- The verb layer this face projects onto HTTP. rest-api holds a compile dependency on control-core
         (and the core ring it carries), never on the storage port directly (R5): the store-backed apply /
         query services are constructed at the assembly root and injected here as control-core types. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>control-core</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- The Web MVC substrate (Spring Boot 4.1.x on Spring Framework 7 / Jakarta EE 11): embedded
         servlet container + the HTTP JSON wire codec. Versions come from the reactor BOM. This is the
         only ring where Spring is admitted (R5); the control-core verb layer stays framework-free. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Servlet authentication and authorization filters. The configured chains stay stateless and retain
         Tapstate's own credential formats, error codes, operation registry, and bootstrap flow. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- The thin websocket channel carrying the two streaming read sugars (watch a pipeline's status,
         follow its logs). Spring's raw WebSocketHandler abstraction only (never a STOMP broker or general
         push framework) plus the servlet-container websocket support; still org.springframework under R5. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <!-- The shared error-code catalog + renderer (presentation-layer leaf, core-ring-only, no third-party):
         this HTTP face renders coded errors the same way every other presentation face does (the CLI, the
         assembly root). Granted to rest-api by the R5 ArchUnit rule, like the CLI's R6 grant. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>messages</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- Test only. The web context is booted programmatically (SpringApplication, not the Spring
         JUnit extension) so the module stays on the reactor's JUnit line; versions come from the BOM. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- This module's only resource is the version stamp, and it is useless unfiltered: an
           unsubstituted placeholder is served to clients as though it were a version. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- The version this face reports over HTTP is filtered in from the reactor at build time, so it
           tracks the single source of truth instead of being a second copy someone has to remember to
           bump. Handing the same project version to the tests lets a guard assert the served value
           against the build rather than against itself. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <tapstate.project.version>${project.version}</tapstate.project.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
