<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tapstate</groupId>
    <artifactId>control</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>mcp-server</artifactId>
  <name>Tapstate :: Control :: MCP Server</name>
  <description>Local stdio MCP sidecar that projects control operations onto the HTTP contract.</description>

  <properties>
    <mainClass>io.tapstate.mcp.TapstateMcpApplication</mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>control-client</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>control-core</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>messages</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The version this sidecar announces in the MCP handshake is a configured property, not a
           compiled constant, so a release can leave it behind with nothing to notice. Handing the real
           project version to the tests turns that drift into a red build. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <tapstate.project.version>${project.version}</tapstate.project.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-mcp-sidecar-scope</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework.ai:spring-ai-starter-model-*</exclude>
                    <exclude>org.springframework.ai:spring-ai-openai*</exclude>
                    <exclude>org.springframework.ai:spring-ai-anthropic*</exclude>
                    <exclude>org.springframework.ai:spring-ai-rag</exclude>
                    <exclude>org.springframework.ai:spring-ai-vector-store</exclude>
                    <exclude>org.springframework.ai:spring-ai-starter-mcp-server-web*</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-web*</exclude>
                  </excludes>
                  <message>
The MCP sidecar contains only the stdio protocol server. Model providers, RAG, vector stores,
web transports, and embedded web servers belong outside this process.
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>repackage-boot-jar</id>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <classifier>boot</classifier>
              <mainClass>${mainClass}</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
