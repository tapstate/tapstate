# Build output
target/
build/
dist/
*.class
.flattened-pom.xml

# macOS
.DS_Store

# IDE / editor (per-developer, never shared)
.idea/
.vscode/
*.iml
.claude/

# Node (web tooling, if any)
node_modules/

# Env files
.env
.env.*
!.env.example

# Server logs, written under the working directory by any test that boots the product
logs/
*.log
*.tmp

# Scratch directories the online-runtime walkthrough creates at the repository root:
# downloaded connector jars, the plugin cache the server unpacks them into, and the
# authored workspace. Tens of megabytes of binaries a reader would otherwise commit.
/connectors/
# Connector jars staged for a from-source run of the quickstart stack. The directory itself is
# tracked (it ships a README and the compose file mounts it); the jars a developer drops in for a
# local run are ~120MB and are not.
/deploy/quickstart/connectors/*.jar
/plugins/
/work/

# A generated quickstart .env holds a demo password; never commit it (the .env.example is the template).
deploy/quickstart/.env
