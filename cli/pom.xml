<?xml version="1.0" encoding="UTF-8"?>
<!--
  cli — the surface ring: Tapstate's offline CLI product front-end.

  Dual-mode: bare `tapstate` opens an offline REPL; one-shot subcommands share the same verb
  table for scripting / AI. Offline verbs are a whitelist (validate / new / explain); server
  verbs are registered too but report "requires a connection" rather than going missing.

  Ring rule R6: the CLI talks to services over HTTP only. Its dependency surface is allowlisted
  (bannedDependencies, the coarse twin of the arch-tests R6 rule): the named core-ring modules,
  the framework-free control HTTP client, picocli (command framework), TamboUI, and jline.
  Product control services and runtime implementations remain forbidden. Every allowed artifact is
  listed explicitly, so a new dependency fails the build until its boundary is deliberately reviewed.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tapstate</groupId>
    <artifactId>tapstate</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>cli</artifactId>
  <name>Tapstate :: CLI</name>
  <description>CLI product front-end: offline authoring plus HTTP control-plane verbs, packaged as
    a native image. Depends on core contracts and the framework-free HTTP client (rule R6).</description>

  <properties>
    <mainClass>io.tapstate.cli.Cli</mainClass>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.tapstate</groupId>
        <artifactId>bom</artifactId>
        <version>${revision}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The offline DSL link: workspace load = parse + validate (structure / reference / capability). -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-dsl</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The same-source grammar JSON Schema that backs explain / completion. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-schema</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The bundled connector catalog: the wizard reads it to offer connectors / modes / config. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-catalog</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The error-code contract: severity drives exit codes; TapstateException is the rendered carrier. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-common</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- The shared error-code message catalog + renderer (presentation layer); the CLI renders
         coded diagnostics through it rather than carrying its own catalog. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>messages</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>control-client</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- Surface-ring facade libraries (R6 allowlist). -->
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jline</groupId>
      <artifactId>jline</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.tamboui</groupId>
      <artifactId>tamboui-tui</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.tamboui</groupId>
      <artifactId>tamboui-jline3-backend</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- picocli's annotation processor emits the native-image reflection config for the command
           tree at compile time, so the native binary needs no hand-written reflect config. It runs
           on every build (harmless on the JVM); the generated config lands under
           META-INF/native-image/io.tapstate/cli and is picked up automatically by the native build.
           picocli-codegen is an annotationProcessorPath, not a project dependency, so it is outside
           the R6 dependency allowlist below; its version is inherited from the BOM. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>info.picocli</groupId>
              <artifactId>picocli-codegen</artifactId>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Aproject=io.tapstate/cli</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- What `-V` prints is a compile-time constant in Cli, so that the version costs neither a jar
           manifest nor a bundled resource in the native image (a manifest is absent there, and a
           resource would need its own IncludeResources glob). The cost of a constant is that a release
           can leave it behind, shipping a binary that misreports its own version. Handing the real
           project version to the tests turns that drift into a red build instead. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <tapstate.project.version>${project.version}</tapstate.project.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- R6 coarse gate: only named core modules, control-client, picocli, TamboUI, and jline on the surface.
           The fine-grained twin is the arch-tests R6 ArchUnit rule. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-cli-ring-whitelist</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- Direct dependencies only: the CLI adds no third-party beyond picocli, TamboUI, and jline.
                       The DSL link's own libraries (snakeyaml, cel, jackson-annotations) arrive
                       transitively through the core ring, which governs that surface under R1 — they
                       are not the CLI's to re-allowlist. This gate covers direct deps; the arch-tests
                       R6 rule covers the package edges the CLI's bytecode actually references. A
                       Product control and runtime rings cannot reach the CLI transitively either;
                       control-client is a framework-free transport leaf. -->
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <!-- the core ring, named one by one (no io.tapstate:* wildcard, so a future
                         control / runtime ring added here is a conscious, build-failing change) -->
                    <include>io.tapstate:core-common</include>
                    <include>io.tapstate:core-model</include>
                    <include>io.tapstate:core-dsl</include>
                    <include>io.tapstate:core-schema</include>
                    <include>io.tapstate:core-catalog</include>
                    <!-- the shared presentation catalog + renderer (zero third-party itself) -->
                    <include>io.tapstate:messages</include>
                    <include>io.tapstate:control-client</include>
                    <include>info.picocli:picocli</include>
                    <include>dev.tamboui:tamboui-tui</include>
                    <include>dev.tamboui:tamboui-jline3-backend</include>
                    <!-- jline aggregates its own modules under one version -->
                    <include>org.jline:*</include>
                    <!-- test scope never ships -->
                    <include>*:*:*:*:test</include>
                  </includes>
                  <message>
Dependency outside the cli surface-ring allowlist (rule R6). Only io.tapstate modules, picocli,
TamboUI, and jline are allowed; the CLI must reach services over HTTP, never via a compile dependency on
control / runtime modules. Amend the recorded allowlist decision before adding an exception.
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Runnable thin jar for manual verification (the native image is the production shape, D5):
           java -jar cli/target/cli-<ver>.jar -> the dependencies sit in target/lib next to it. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${mainClass}</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-runtime-deps</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The production shape: a native-image binary `tapstate`. Off by default (the JVM jar builds
      without native-image); activate with `-Pnative` on a machine with a JDK-21 native-image
      toolchain: Liberica NIK (GPLv2+CPE) for release builds, Oracle GraalVM for local dev.

      The bundled resources read at runtime via getResourceAsStream are not reachable in a native
      image unless declared: the connector catalog (/catalog/*.json), the grammar JSON Schema
      (/schema/*.json), the message catalog (/messages/*.yml), and TamboUI's built-in key bindings.
      They are declared here as IncludeResources globs. Reflection config for the picocli command tree comes from the
      picocli-codegen processor (see the compiler plugin above); JLine / CEL / snakeyaml config
      comes from the GraalVM reachability-metadata repository.
    -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <phase>package</phase>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <imageName>tapstate</imageName>
              <mainClass>${mainClass}</mainClass>
              <buildArgs>
                <buildArg>--no-fallback</buildArg>
                <!-- bundled resources read via getResourceAsStream, declared so the image keeps them -->
                <buildArg>-H:IncludeResources=catalog/.*\.json</buildArg>
                <buildArg>-H:IncludeResources=schema/.*\.json</buildArg>
                <buildArg>-H:IncludeResources=messages/.*\.yml</buildArg>
                <buildArg>-H:IncludeResources=dev/tamboui/tui/bindings/.*\.properties</buildArg>
              </buildArgs>
              <metadataRepository>
                <enabled>true</enabled>
              </metadataRepository>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
