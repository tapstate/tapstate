$accent: #2A7481;

#base       { color: #203033; background: #F7FAFA; }
#accent     { color: $accent; }
#accent-bg  { color: white; background: $accent; text-style: bold; }
#hint-key   { color: white; background: $accent; text-style: bold; }
#title      { color: $accent; text-style: bold; }
#muted      { color: #647477; }
#selection  { color: black; background: #B9E1E5; text-style: bold; }
#success    { color: #16785B; }
#warning    { color: #8A6500; }
#error      { color: #B42318; }
#info       { color: #225D8A; }
#label      { color: #725E12; }
