<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tapstate</groupId>
    <artifactId>core</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>core-dsl</artifactId>
  <name>Tapstate :: Core :: DSL</name>
  <description>YAML parse / validate / CEL checking for .tap.yml artifacts; carries the ADR-0016 §14 corpus</description>

  <dependencies>
    <!-- compile scope: the error-code contract (TapstateException / TapstateErrorCode) — DslError
         is the dsl domain's first consumer (ADR-0024) -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-common</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- compile scope: the parse layer (B3) produces core-model resource objects -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-model</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- compile scope: the capability-matrix validation layer (C3) consults the connector-derived
         catalog schema for mode × connector legality and config field type / enum checks. Both are
         core-ring modules, so this is an intra-ring dependency (no third-party surface added). -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-catalog</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- snakeyaml at compile scope: the parse layer (B3) reads .tap.yml. The core-ring
         allowlist grant for it lives in this module's enforcer override below (R1). -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>

    <!-- compile scope: the SQL front end, so a join's sql: is read and refused while the
         artifact is being parsed rather than when a pipeline is assembled from it. The whole point
         of that gate is that the shapes it refuses run silently wrong, so it has to sit in the
         offline path, which is here. Only this module's narrow API is reachable: the SQL
         library's own types stay banned in core-dsl by the fine-grained ring rule, which the
         allowlist below cannot loosen. -->
    <dependency>
      <groupId>io.tapstate</groupId>
      <artifactId>core-sql</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- cel-java at compile scope: the validate layer (B4) compiles + type-checks §12 CEL
         expressions. It drags a transitive closure (guava / protobuf / antlr4 / re2j and their
         own deps); the whole closure is allowlisted to core-dsl ONLY in the enforcer below (R1). -->
    <dependency>
      <groupId>dev.cel</groupId>
      <artifactId>cel</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Core-ring allowlist grant (R1): snakeyaml and cel-java (with its full transitive
           closure) are permitted at compile scope in core-dsl ONLY. Appends to the parent core
           ring's enforce-core-ring-whitelist rule (core/pom.xml); every other core module still
           bans them. The cel closure is named artifact-by-artifact on purpose: a cel upgrade that
           drags in a new transitive dependency trips this gate and forces a conscious re-review
           rather than silently widening the core ring's third-party surface. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-core-ring-whitelist</id>
            <configuration>
              <rules>
                <bannedDependencies>
                  <includes combine.children="append">
                    <include>org.yaml:snakeyaml</include>
                    <!-- cel-java aggregate -->
                    <include>dev.cel:cel</include>
                    <!-- guava + its companions -->
                    <include>com.google.guava:guava</include>
                    <include>com.google.guava:failureaccess</include>
                    <include>com.google.guava:listenablefuture</include>
                    <include>com.google.j2objc:j2objc-annotations</include>
                    <!-- protobuf (cel encodes ASTs as protobuf) -->
                    <include>com.google.protobuf:protobuf-java</include>
                    <include>com.google.protobuf:protobuf-javalite</include>
                    <!-- regex + parser runtimes -->
                    <include>com.google.re2j:re2j</include>
                    <include>org.antlr:antlr4-runtime</include>
                    <!-- annotation-only deps (no runtime behavior) -->
                    <include>com.google.auto.value:auto-value-annotations</include>
                    <include>com.google.code.findbugs:annotations</include>
                    <include>com.google.code.findbugs:jsr305</include>
                    <include>net.jcip:jcip-annotations</include>
                    <include>com.google.errorprone:error_prone_annotations</include>
                    <include>org.jspecify:jspecify</include>
                    <!-- date/time backport used by cel timestamp/duration -->
                    <include>org.threeten:threeten-extra</include>
                    <!-- the SQL front end's closure, inherited through core-sql rather than
                         declared here. It is repeated because this rule reads the resolved tree,
                         not the declarations, so a transitive arrival is indistinguishable from a
                         direct one to it. Kept identical to core-sql/pom.xml on purpose: an upgrade
                         that drags in one of the artifacts excluded there (a runtime Java compiler,
                         a JDBC pool, a geospatial stack) trips this gate here too. The types
                         themselves remain out of reach, because the fine-grained R1 rule grants
                         org.apache.calcite.. to core-sql alone and nothing in this pom widens it. -->
                    <include>org.apache.calcite:calcite-core</include>
                    <include>org.apache.calcite:calcite-linq4j</include>
                    <include>org.apache.calcite.avatica:avatica-core</include>
                    <include>org.apache.commons:commons-math3</include>
                    <include>org.slf4j:slf4j-api</include>
                    <include>org.checkerframework:checker-qual</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
